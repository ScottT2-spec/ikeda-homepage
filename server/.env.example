PORT=4000
# In production, lock this to the real homepage origin instead of leaving it open.
ALLOWED_ORIGIN=*
# Required to read submissions back via GET /api/submissions (x-admin-token header)
ADMIN_TOKEN=change-me

# Admin login (/admin) -- only used to seed the account on first boot.
# Change the password immediately after first login; these are not
# read again afterward.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# Signs admin login sessions -- set a long random value in production.
JWT_SECRET=change-me-too
